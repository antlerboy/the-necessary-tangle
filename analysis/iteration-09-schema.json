{
  "journeys": [
    {
      "id": "journey_emergence_self_org",
      "title": "Emergence without magic",
      "subtitle": "What complexity adds, and what the words do not explain",
      "summary": "A route through local interaction, cross-scale pattern and the limits of command.",
      "audience": "complexity-curious reader",
      "duration_minutes": 10,
      "steps": [
        {
          "node_id": "concept_self_organisation",
          "heading": "Order without central prescription",
          "narrative": "Local interactions can produce global order. That does not remove constraints, resources, power or environment."
        },
        {
          "node_id": "concept_emergence",
          "heading": "A property at another scale",
          "narrative": "Emergence names a cross-scale relation. It does not itself tell you which mechanism generated the pattern."
        },
        {
          "node_id": "concept_positive_feedback",
          "heading": "Find amplification",
          "narrative": "Reinforcing loops can magnify small differences and create tipping or path dependence."
        },
        {
          "node_id": "concept_negative_feedback",
          "heading": "Find limits and balancing",
          "narrative": "Growth and novelty usually meet balancing loops, resource constraints or saturation."
        },
        {
          "node_id": "concept_regulation",
          "heading": "Intervene in conditions",
          "narrative": "In complex situations, intervention often changes constraints, connections and response capacity rather than delivering a predetermined outcome."
        }
      ]
    },
    {
      "id": "journey_feedback_regulation",
      "title": "From feedback to regulation",
      "subtitle": "How systems respond after, before and during disturbance",
      "summary": "A guided route through feedback, feedforward, homeostasis and regulatory capacity.",
      "audience": "practitioner",
      "duration_minutes": 12,
      "steps": [
        {
          "node_id": "concept_feedback",
          "heading": "Close the loop",
          "narrative": "Consequences return to influence later action. A report that cannot alter action is not much of a feedback loop."
        },
        {
          "node_id": "concept_negative_feedback",
          "heading": "Counteract deviation",
          "narrative": "Balancing feedback can maintain a range, but delay and excessive correction can make the loop oscillate."
        },
        {
          "node_id": "concept_positive_feedback",
          "heading": "Reinforce change",
          "narrative": "Reinforcing loops explain escalation, tipping and lock-in. Positive does not mean beneficial."
        },
        {
          "node_id": "concept_feedforward",
          "heading": "Act before the result",
          "narrative": "Feedforward uses anticipation or measured disturbance. Its price is dependence on a model or forecast."
        },
        {
          "node_id": "concept_homeostasis",
          "heading": "Maintain viability dynamically",
          "narrative": "Homeostasis names the maintained condition and the organisation of regulation, not one universal loop."
        },
        {
          "node_id": "concept_regulation",
          "heading": "See the broader problem",
          "narrative": "Regulation combines responses, constraints, sensing and acceptable outcomes. It need not be central command."
        }
      ]
    },
    {
      "id": "journey_variety_vsm",
      "title": "From variety to viable organisation",
      "subtitle": "Why autonomy, intelligence and coordination have to be designed together",
      "summary": "A practical route from distinctions and disturbance to the Viable System Model.",
      "audience": "organisation designer",
      "duration_minutes": 14,
      "steps": [
        {
          "node_id": "concept_variety",
          "heading": "Count differences that matter",
          "narrative": "Variety begins with distinctions. Different observers and purposes reveal different sets of possible states."
        },
        {
          "node_id": "concept_requisite_variety",
          "heading": "Match response to disturbance",
          "narrative": "Only usable response variety can reduce disturbance variety. More options that cannot affect outcomes add noise, not regulation."
        },
        {
          "node_id": "concept_variety_attenuation",
          "heading": "Reduce what must be handled",
          "narrative": "Attenuation filters or redesigns variety, but must retain exceptions and ethical visibility."
        },
        {
          "node_id": "concept_variety_amplification",
          "heading": "Increase usable repertoire",
          "narrative": "Amplification adds sensing, capability, authority and relationships rather than simply adding activity."
        },
        {
          "node_id": "concept_transduction",
          "heading": "Transform across boundaries",
          "narrative": "Different organisational worlds need coding and decoding. The information is changed in the crossing."
        },
        {
          "node_id": "concept_organisational_recursion",
          "heading": "Choose the system-in-focus",
          "narrative": "Operational units may themselves be viable systems. Requirements recur, but implementation changes with level and environment."
        },
        {
          "node_id": "concept_viability",
          "heading": "Hold identity and adaptation together",
          "narrative": "The design question is whether the whole can keep acting coherently while its environment changes."
        },
        {
          "node_id": "method_or_methodology_viable_system_model_vsm",
          "heading": "Hold autonomy and cohesion together",
          "narrative": "The VSM examines whether operations, coordination, control, intelligence and identity form a viable whole without crushing local variety."
        }
      ]
    },
    {
      "id": "journey_observer_boundary",
      "title": "How a system becomes visible",
      "subtitle": "Observer, distinction, boundary, purpose and information",
      "summary": "A route through the usually hidden work that makes a situation intelligible enough for action.",
      "audience": "systems practitioner",
      "duration_minutes": 13,
      "steps": [
        {
          "node_id": "concept_observer",
          "heading": "Locate the observer",
          "narrative": "Every account begins from capacities, sensors, histories and stakes. Naming the observer makes limits and responsibilities inspectable."
        },
        {
          "node_id": "concept_distinction",
          "heading": "Notice the cut",
          "narrative": "The observer marks differences. The cut makes some patterns graspable and leaves others in the unmarked remainder."
        },
        {
          "node_id": "concept_boundary",
          "heading": "Form a system of concern",
          "narrative": "A cluster of distinctions becomes a boundary around what counts, who counts and where responsibility is placed."
        },
        {
          "node_id": "concept_purpose",
          "heading": "Ask what the boundary is for",
          "narrative": "Different purposes create different relevant systems. Purpose also supplies the criteria by which performance and viability will be judged."
        },
        {
          "node_id": "concept_information",
          "heading": "See what can become signal",
          "narrative": "The boundary, code and receiving organisation decide which differences become information and which become noise."
        }
      ]
    },
    {
      "id": "journey_viability",
      "title": "How a whole persists without becoming rigid",
      "subtitle": "Identity, adaptation, autonomy, cohesion and viability",
      "summary": "A route through the central tension of viable organisation: changing enough without dissolving the whole.",
      "audience": "leader and organisation designer",
      "duration_minutes": 12,
      "steps": [
        {
          "node_id": "concept_identity",
          "heading": "Name what must remain recognisable",
          "narrative": "Identity is continuity through change, not a demand that structures never change."
        },
        {
          "node_id": "concept_adaptation",
          "heading": "Respond to environmental change",
          "narrative": "Change becomes adaptation only in relation to an environment, timescale and viability condition."
        },
        {
          "node_id": "concept_autonomy",
          "heading": "Give parts regulatory capacity",
          "narrative": "Local units need discretion, information and resources to handle local variety."
        },
        {
          "node_id": "concept_cohesion",
          "heading": "Keep the parts a whole",
          "narrative": "Shared identity, lateral coordination and residual escalation integrate parts without erasing their differences."
        },
        {
          "node_id": "concept_viability",
          "heading": "Hold the tension dynamically",
          "narrative": "Viability is the ongoing capacity to remain a recognisable actor while operations, learning and environment change."
        },
        {
          "node_id": "method_or_methodology_viable_system_model_vsm",
          "heading": "Diagnose the organisation",
          "narrative": "The VSM offers one disciplined way to examine these functions recursively across levels."
        }
      ]
    },
    {
      "id": "journey_read_the_tangle",
      "title": "How to read The Necessary Tangle",
      "subtitle": "Why the line matters as much as the dot",
      "summary": "A short orientation to typed relations, evidence and disagreement.",
      "audience": "new visitor",
      "duration_minutes": 6,
      "steps": [
        {
          "node_id": "concept_feedback",
          "heading": "Begin with a familiar word",
          "narrative": "Feedback seems simple until engineering, physiology, cybernetics, learning and everyday evaluation all use the same word differently."
        },
        {
          "node_id": "concept_negative_feedback",
          "heading": "Separate a subtype",
          "narrative": "Negative feedback is not a negative judgement. The relation type tells you that it specialises the broader feedback concept."
        },
        {
          "node_id": "concept_homeostasis",
          "heading": "Do not merge neighbours",
          "narrative": "Homeostasis often uses feedback but names a maintained viable condition and organisation. The atlas records the confusion rather than flattening it."
        },
        {
          "node_id": "concept_requisite_variety",
          "heading": "Follow evidence, not resemblance",
          "narrative": "A logical prerequisite, a historical precursor and a later practical use are different lines and demand different evidence."
        },
        {
          "node_id": "method_or_methodology_viable_system_model_vsm",
          "heading": "Move from concept to practice",
          "narrative": "The VSM page shows how concepts are used in a method without implying that every intellectual neighbour directly caused it."
        }
      ]
    },
    {
      "id": "journey_recursion",
      "title": "Recursion: more than nested boxes",
      "subtitle": "From definitions and computation to organisational levels",
      "summary": "A route that separates formal recursion from hierarchy, fractals and organisational analogy.",
      "audience": "systems practitioner",
      "duration_minutes": 9,
      "steps": [
        {
          "node_id": "concept_recursion",
          "heading": "Name the recurrence rule",
          "narrative": "A recursive claim must say what recurs, how another instance is reached and where the process stops or changes."
        },
        {
          "node_id": "concept_recursive_definition",
          "heading": "Definition by smaller cases",
          "narrative": "Formal recursive definitions require a base case or well-founded order."
        },
        {
          "node_id": "concept_recursive_computation",
          "heading": "A procedure calls itself",
          "narrative": "Computational recursion is one domain-specific form, not the master meaning for every field."
        },
        {
          "node_id": "concept_organisational_recursion",
          "heading": "Viability requirements recur",
          "narrative": "In organisational cybernetics, operational systems may contain operations and meta-systemic functions of their own."
        },
        {
          "node_id": "method_or_methodology_viable_system_model_vsm",
          "heading": "Map the system-in-focus",
          "narrative": "The practical value lies in locating autonomy, environment and regulatory functions at the right level, not drawing more boxes."
        }
      ]
    },
    {
      "id": "journey_transduction",
      "title": "What happens at the boundary",
      "subtitle": "Information, transduction and variety engineering",
      "summary": "A practical route through the transformations hidden inside hand-offs, reporting and policy-to-practice translation.",
      "audience": "public-service and organisation practitioner",
      "duration_minutes": 12,
      "steps": [
        {
          "node_id": "concept_boundary",
          "heading": "Find the crossing",
          "narrative": "A hand-off is a meeting between differently organised worlds, not movement across an empty line."
        },
        {
          "node_id": "concept_information",
          "heading": "Identify the difference to be carried",
          "narrative": "Ask what must be preserved for the receiver to act responsibly, and what the current channel cannot represent."
        },
        {
          "node_id": "concept_transduction",
          "heading": "Trace the transformation",
          "narrative": "Coding and decoding change the message. A citizen becomes a case; work becomes a metric; strategy becomes an instruction."
        },
        {
          "node_id": "concept_variety_attenuation",
          "heading": "See what is filtered out",
          "narrative": "Attenuation makes work manageable, but can also externalise complexity onto people with less power."
        },
        {
          "node_id": "concept_variety_amplification",
          "heading": "Increase usable response",
          "narrative": "Amplification adds sensing, authority, capability, tools or relationships so that more relevant variety can be handled."
        },
        {
          "node_id": "method_or_methodology_viable_system_model_vsm",
          "heading": "Design channels and responsibilities",
          "narrative": "The VSM turns these questions into an organisation diagnosis of operations, coordination, control, intelligence and identity."
        }
      ]
    }
  ],
